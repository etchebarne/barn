{
  "name": "@openbot/desktop",
  "productName": "openbot",
  "version": "0.0.0",
  "private": true,
  "description": "openbot for the desktop",
  "author": "Martin Etchebarne",
  "homepage": "https://github.com/etchebarne/openbot",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/*.html dist/",
    "dev": "pnpm build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/*.test.js",
    "dist": "pnpm build && electron-builder --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  },
  "desktopName": "openbot.desktop"
}
