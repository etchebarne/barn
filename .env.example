# Server settings only. The model provider (API key) and models are configured in the app's
# onboarding and stored in the database.

# Where barnd stores its SQLite database and other state
BARN_DATA_DIR=./data

# Address to listen on. Use your Tailscale IP (e.g. 100.x.y.z:8080) to keep it private.
BARN_ADDR=127.0.0.1:8080

# Set to true when served over HTTPS (marks session cookies Secure)
BARN_SECURE_COOKIES=false

# Directory with the built web app (web/dist). Empty = API only (use the Vite dev server).
BARN_WEB_DIR=./web/dist

# Extra origins allowed to open WebSocket connections, comma-separated (e.g. the Vite dev server)
BARN_ALLOWED_ORIGINS=http://localhost:5173
